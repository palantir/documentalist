{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "command": "npm",
    "isShellCommand": true,
    "showOutput": "always",
    "suppressTaskName": true,
    "tasks": [
        {
            "label": "tsc",
            "type": "shell",
            "args": [
                "run",
                "tsc"
            ],
            "problemMatcher": "$tsc",
            "group": {
                "_id": "build",
                "isDefault": false
            }
        },
        {
            "label": "watch",
            "type": "shell",
            "args": [
                "run",
                "watch"
            ],
            "isBackground": true,
            "problemMatcher": "$tsc-watch"
        },
        {
            "label": "test",
            "type": "shell",
            "args": [
                "run",
                "test"
            ],
            "problemMatcher": [],
            "group": {
                "_id": "test",
                "isDefault": false
            }
        }
    ]
}
